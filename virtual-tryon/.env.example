# Copy to .env and fill in. NEVER commit .env.

# ---- Branding ----
BRAND_NAME="Your Brand"

# ---- Live backend selection ----
# "decart" = white-labelled Decart (ship at launch)
# "local"  = our own GPU pipeline (once it is good enough)
LIVE_BACKEND=decart

# ---- Decart (only needed when LIVE_BACKEND=decart) ----
# Real production key stays server-side ONLY. Never sent to the browser.
DECART_API_KEY=
DECART_MODEL=lucy-vton-3.6          # pin the version; do not use "latest"
DECART_BASE_URL=https://api.decart.ai
DECART_TOKEN_TTL_SECONDS=120        # only gates STARTING a session

# Site address. When set, /live/token only answers this origin and the
# scoped Decart keys only work from it. ALWAYS set this in production.
PUBLIC_ORIGIN=
ACCESS_CODE=                        # optional shared code to start live
TRUST_PROXY=false                   # true behind nginx (real visitor IP)
TOKENS_PER_IP_PER_HOUR=10

# ---- Local GPU engine (only needed when LIVE_BACKEND=local) ----
GPU_ENGINE_URL=http://127.0.0.1:8900   # the engine process on the GPU box

# ---- Limits (spend protection) ----
MAX_SESSION_SECONDS=20                  # hard cap per shopper per live session
PER_STORE_DAILY_SESSIONS=100            # trial allowance per store per day
SITE_DAILY_SESSIONS=2000                # global safety ceiling
SITE_DAILY_SECONDS=120000               # global seconds ceiling (~₹ budget guard)

# ---- Consent + recording (for building our training set) ----
RECORDING_ENABLED=true
RECORD_OUTPUT_FRAMES=false              # keep false until Decart ToS checked; store only inputs
RECORDINGS_DIR=./data/recordings
RECORDING_RETENTION_DAYS=365

# ---- Server ----
HOST=0.0.0.0
PORT=3071                               # 3070 = production Node app on the VPS
