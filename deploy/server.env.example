# Server settings. setup.sh copies this to /etc/live-virtual-try-on.env (readable by root and the app only).

# Required: your Decart API key from https://platform.decart.ai
DECART_API_KEY=

# The public address of the site. Session keys only work from this website.
PUBLIC_ORIGIN=https://live-virtual-try-on.brandzaha.com

# nginx sits in front, so trust its X-Real-IP header for per-visitor limits.
TRUST_PROXY=1
HOST=127.0.0.1
PORT=3000

# Optional: require this code before anyone can start a session. Leave empty for open access.
ACCESS_CODE=

# Cost controls (Decart bills about $0.02 per second of try-on).
MAX_SESSION_SECONDS=120
TOKENS_PER_IP_PER_HOUR=10
DAILY_TOKEN_LIMIT=300
